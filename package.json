		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^16.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^4.2.20",
		"svelte-check": "^4.3.0",
		"typescript": "^5.8.3",
		"vite": "^5.4.19"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
